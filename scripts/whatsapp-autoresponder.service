# systemd --user unit for scripts/whatsapp_autoresponder.py — polls the
# WhatsApp bridge's local message store and auto-replies (via Funes'
# whatsapp-autoresponder agent) to chats on WHATSAPP_WHITELIST only.
#
# Requires WHATSAPP_WHITELIST to be set in config/funes.local (comma-
# separated chat_jids — see the README for how to find them). The script
# refuses to start with an empty whitelist.
#
# Install (on yoda):
#   cp scripts/whatsapp-autoresponder.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now whatsapp-autoresponder
#   journalctl --user -u whatsapp-autoresponder -f

[Unit]
Description=WhatsApp auto-responder poller for Funes (whitelisted chats only)
After=network.target funes.service whatsapp-bridge.service
Wants=funes.service whatsapp-bridge.service

[Service]
Type=simple
WorkingDirectory=/home/julio/Funes
ExecStart=/usr/bin/python3 /home/julio/Funes/scripts/whatsapp_autoresponder.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
