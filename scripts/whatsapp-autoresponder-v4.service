# systemd --user unit for scripts/whatsapp_autoresponder.py against the
# Funes 4.0 install (funes-v4.service, :8485) rather than the 3.x one.
#
# A separate unit rather than an override on whatsapp-autoresponder.service,
# for the same reason funes-v4.service is separate: the two installs share one
# WhatsApp bridge store, and the failure mode of running both pollers is not an
# error — it is one of them silently consuming messages the other never sees.
# Two units make "which one is enabled" a thing you can read off `systemctl`.
#
# **Only one of whatsapp-autoresponder and whatsapp-autoresponder-v4 may be
# enabled at a time.** Both are `enable`-able and neither checks for the other.
#
# The bridge itself (whatsapp-bridge.service) is shared and stays where it is,
# running out of the 3.x clone. Stopping it loses the authenticated WhatsApp
# session and costs a QR re-scan, so it is deliberately not duplicated.
#
# Configuration lives in /home/julio/Funes-v4/config/funes.local (gitignored),
# which this unit's WorkingDirectory makes the script read:
#
#   FUNES_SERVICE_TOKEN   shared secret; the SAME value authenticates the
#                         script to funes-v4, which reads this file too
#   WHATSAPP_WHITELIST    comma-separated chat_jids allowed to trigger a reply
#   FUNES_API_URL         http://localhost:8485
#   WHATSAPP_STATE_PATH   under ~/.funes-v4/, NOT the ~/.funes default, or the
#                         two installs share one read-watermark
#   FUNES_WORKSPACE_DIR   /home/julio/.funes-v4/workspace
#   WHATSAPP_DB_PATH      absolute path to the DEDICATED bridge's messages.db
#
# That last one is the easy one to miss. The autoresponder reads the dedicated
# bridge (store-funes, :8091), not the personal one, and funes.conf gives that
# path *relative to the repo root* — but the v4 clone has no store-funes of its
# own, only a `store` symlink for the MCP server. Left unset the poller crash-
# loops on "unable to open database file". It is set absolute rather than
# symlinked so the coupling to the 3.x clone is visible in config instead of
# hidden in the filesystem; moving both bridge stores somewhere
# install-independent is the real fix and is still outstanding.
#
# A service token says the caller is trusted; it does not say who for. Each
# sender's jid has to be mapped to an account before Funes will answer:
#
#   cd ~/Funes-v4 && FUNES_DB=~/.funes-v4/memory.db \
#       ./bin/funes jid-map '<chat_jid>' <username>
#
# An unmapped jid resolves to nobody, never to a default account.
#
# Install (on yoda):
#   cp scripts/whatsapp-autoresponder-v4.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user disable --now whatsapp-autoresponder
#   systemctl --user enable --now whatsapp-autoresponder-v4
#   journalctl --user -u whatsapp-autoresponder-v4 -f

[Unit]
Description=WhatsApp auto-responder poller for Funes 4.0 (whitelisted chats only)
After=network.target funes-v4.service whatsapp-bridge.service
Wants=funes-v4.service whatsapp-bridge.service
# Refuses to run alongside the 3.x poller even if both were enabled by
# mistake. systemd stops the other one rather than starting two.
Conflicts=whatsapp-autoresponder.service

[Service]
Type=simple

# The v4 clone. This is also what makes ./config/funes.local resolve to v4's,
# so it must not be the 3.x checkout — the script reads its whole
# configuration relative to this directory.
WorkingDirectory=/home/julio/Funes-v4
ExecStart=/usr/bin/python3 /home/julio/Funes-v4/scripts/whatsapp_autoresponder.py

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
