# systemd --user unit for the Funes 4.0 install.
#
# This is now the ONLY Funes install on yoda. The 3.x install was retired on
# 2026-08-31: funes.service and whatsapp-autoresponder.service were disabled
# and their unit files moved to ~/retired-3x/systemd/, and the tree was
# archived to ~/funes-3x-archive-20260831.zip.
#
# /home/julio/Funes still exists and must NOT be deleted: both WhatsApp
# bridges run out of it, and this install reads their stores through
# third-party/whatsapp-mcp/whatsapp-bridge/store (a symlink) and the absolute
# WHATSAPP_DB_PATH in config/funes.local. Its database ~/.funes/memory.db is
# dormant, and was migrated to the 4.0 schema on 2026-08-31, so a 3.x binary
# can no longer open it.
#
# Every path and port below is set explicitly, and that is the point rather
# than verbosity. Funes loads ./config/funes.conf and ~/.funes/config into the
# environment with setenv(overwrite=0), so anything NOT set here can be filled
# in by a config file — including one belonging to the 3.x install. An
# unset FUNES_DB means the binary opens ~/.funes/memory.db and migrates it in
# place, and there is no downgrade.
#
# Install (on yoda):
#   cp scripts/funes-v4.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now funes-v4
#   journalctl --user -u funes-v4 -f
#
# See docs/deploy-v4-yoda.md for the full runbook, including the one-time
# data migration from 3.x.

[Unit]
Description=Funes 4.0 (independent install, parallel to funes.service)
After=network.target

[Service]
Type=simple

# The v4 clone. Also where ./config/funes.local is read from, so this must
# not be the 3.x checkout.
WorkingDirectory=/home/julio/Funes-v4
ExecStart=/home/julio/Funes-v4/bin/funes

# ── isolation: separate from the 3.x install ─────────────────────────────────
Environment=FUNES_DB=/home/julio/.funes-v4/memory.db
Environment=FUNES_WORKSPACE_DIR=/home/julio/.funes-v4/workspace
Environment=FUNES_PORT=8485
Environment=FUNES_HOST=0.0.0.0

# ── LLM backends (always local) ──────────────────────────────────────────────
# 127.0.0.1, not the hostname: llama-server binds 0.0.0.0 (IPv4 only), and
# when the wired interface is down the hostname resolves to IPv6 first,
# which times out silently — broke every cron job on 2026-09-05.
Environment=FUNES_LLM_URL=http://127.0.0.1:8080
Environment=FUNES_EMBED_URL=http://127.0.0.1:8081

# ── deliberately off ─────────────────────────────────────────────────────────
# Empty, not absent: an empty value still blocks config/funes.conf (which sets
# http://yoda:8083) from filling it in, and Funes reads set-but-empty as
# unset. Images therefore go to the main model on :8080, which needs an
# --mmproj loaded to actually read them.
Environment=FUNES_VISION_URL=
# funes.conf ships FUNES_ALLOW_SHELL=1. This install has no business running
# shell commands or scheduled shell jobs.
Environment=FUNES_ALLOW_SHELL=0
# No service token: the WhatsApp autoresponder is not run against this
# install (one bridge store, two pollers, both answering). Absent means
# service authentication is off, not open.
# 3.x was retired on 2026-08-31 (units removed, install archived to
# ~/funes-3x-archive-20260831.zip), so this install owns the schedule and the
# runner starts. This began as a cron.conf drop-in on 2026-08-26, back when
# both installs existed and either would have fired the same jobs; it is
# folded in here now that there is no second install to double up with.
#
# config/funes.local sets FUNES_CRON_ENABLED=0 so that a hand-run of
# ./bin/funes does NOT fire the schedule. This line still wins for the
# service, because the real environment beats the config file
# (load_config uses setenv with overwrite=0).
Environment=FUNES_CRON_ENABLED=1

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
